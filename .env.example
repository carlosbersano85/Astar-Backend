# PostgreSQL (required for Prisma)
DATABASE_URL="postgresql://USER:123@localhost:5432/astar?schema=public"

# Optional
PORT=3000
JWT_SECRET=your-secret-change-in-production

# Frontend URL for PayPal redirects
FRONTEND_URL=http://localhost:8080

# PayPal credentials
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_WEBHOOK_URL=http://localhost:3000/api/paypal/webhook

# PayPal plan IDs
PAYPAL_PLAN_ID_ESSENTIALS_MONTHLY=
PAYPAL_PLAN_ID_ESSENTIALS_ANNUAL=
PAYPAL_PLAN_ID_PORTAL_MONTHLY=
PAYPAL_PLAN_ID_PORTAL_ANNUAL=
PAYPAL_PLAN_ID_DEPTH_MONTHLY=
PAYPAL_PLAN_ID_DEPTH_ANNUAL=

# PayPal Extra Session Pricing 
PAYPAL_EXTRA_SESSION_PRICE_SUBSCRIBER=
PAYPAL_EXTRA_SESSION_PRICE_NON_SUBSCRIBER=
PAYPAL_EXTRA_SESSION_CURRENCY=USD
