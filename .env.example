# PostgreSQL (required for Prisma)
DATABASE_URL="postgresql://USER:123@localhost:5432/astar?schema=public"

# Optional
PORT=3000
JWT_SECRET=your-secret-change-in-production
# Local billing simulation mode. Set true to test subscription flows without provider sandbox accounts.
BILLING_TEST_MODE=false

# Frontend URL for PayPal redirects
FRONTEND_URL=http://localhost:8080

# PayPal credentials
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_WEBHOOK_URL=http://localhost:3000/api/paypal/webhook

# PayPal plan IDs
PAYPAL_PLAN_ID_ESSENTIALS_MONTHLY=
PAYPAL_PLAN_ID_ESSENTIALS_ANNUAL=
PAYPAL_PLAN_ID_LUMINARY_MONTHLY=
PAYPAL_PLAN_ID_LUMINARY_ANNUAL=
PAYPAL_PLAN_ID_PORTAL_MONTHLY=
PAYPAL_PLAN_ID_PORTAL_ANNUAL=
PAYPAL_PLAN_ID_DEPTH_MONTHLY=
PAYPAL_PLAN_ID_DEPTH_ANNUAL=

# PayPal Extra Session Pricing 
PAYPAL_EXTRA_SESSION_PRICE_SUBSCRIBER=
PAYPAL_EXTRA_SESSION_PRICE_NON_SUBSCRIBER=
PAYPAL_EXTRA_SESSION_CURRENCY=USD

# Mercado Pago credentials
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_URL=
MERCADOPAGO_BACK_URL_SUCCESS=
MERCADOPAGO_BACK_URL_FAILURE=
MERCADOPAGO_BACK_URL_PENDING=
MERCADOPAGO_AUTO_RETURN=
MERCADOPAGO_SUBSCRIPTION_BACK_URL=
# Currency used when creating Mercado Pago subscriptions (e.g. USD, ARS, BRL, COP).
MERCADOPAGO_SUBSCRIPTION_CURRENCY=USD
# Use checkout for local development with localhost URLs.
# Use preapproval in production together with a public HTTPS MERCADOPAGO_SUBSCRIPTION_BACK_URL.
MERCADOPAGO_SUBSCRIPTION_MODE=checkout
