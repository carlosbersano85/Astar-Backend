# PostgreSQL (required for Prisma)
DATABASE_URL="postgresql://USER:123@localhost:5432/astar?schema=public"

# Optional
PORT=3000
JWT_SECRET=your-secret-change-in-production
# Local billing simulation mode. Set true to test subscription flows without provider sandbox accounts.
BILLING_TEST_MODE=false

# Frontend URL for PayPal redirects
FRONTEND_URL=http://localhost:8080

# PayPal credentials
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
PAYPAL_WEBHOOK_URL=http://localhost:3000/api/paypal/webhook

# PayPal plan IDs
SERVICE_CURRENCY=USD
PAYPAL_PLAN_ID_LUMINARY_MONTHLY=


# Per-service PayPal pricing (subscriber / non-subscriber)
PAYPAL_SERVICE_CURRENT_MOMENT_SUBSCRIBER=
PAYPAL_SERVICE_CURRENT_MOMENT_NON_SUBSCRIBER=
PAYPAL_SERVICE_INNER_ENERGY_SUBSCRIBER=
PAYPAL_SERVICE_INNER_ENERGY_NON_SUBSCRIBER=
PAYPAL_SERVICE_MAKING_DECISION_SUBSCRIBER=
PAYPAL_SERVICE_MAKING_DECISION_NON_SUBSCRIBER=
PAYPAL_SERVICE_NEXT_6_MONTHS_SUBSCRIBER=
PAYPAL_SERVICE_NEXT_6_MONTHS_NON_SUBSCRIBER=
PAYPAL_SERVICE_NEXT_12_MONTHS_SUBSCRIBER=
PAYPAL_SERVICE_NEXT_12_MONTHS_NON_SUBSCRIBER=
PAYPAL_SERVICE_PERSONAL_AUDIO_SUBSCRIBER=
PAYPAL_SERVICE_PERSONAL_AUDIO_NON_SUBSCRIBER=
PAYPAL_SERVICE_LIVE_BIRTH_CHART_SUBSCRIBER=
PAYPAL_SERVICE_LIVE_BIRTH_CHART_NON_SUBSCRIBER=
PAYPAL_SERVICE_LIVE_SOLAR_RETURN_SUBSCRIBER=
PAYPAL_SERVICE_LIVE_SOLAR_RETURN_NON_SUBSCRIBER=
PAYPAL_SERVICE_THREE_QUESTIONS_SUBSCRIBER=
PAYPAL_SERVICE_THREE_QUESTIONS_NON_SUBSCRIBER=

# Mercado Pago credentials
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_URL=
MERCADOPAGO_BACK_URL_SUCCESS=
MERCADOPAGO_BACK_URL_FAILURE=
MERCADOPAGO_BACK_URL_PENDING=
MERCADOPAGO_AUTO_RETURN=
MERCADOPAGO_SUBSCRIPTION_BACK_URL=
# Currency used when creating Mercado Pago subscriptions (e.g. USD, ARS, BRL, COP).
MERCADOPAGO_SUBSCRIPTION_CURRENCY=USD
# Use checkout for local development with localhost URLs.
# Use preapproval in production together with a public HTTPS MERCADOPAGO_SUBSCRIPTION_BACK_URL.
MERCADOPAGO_SUBSCRIPTION_MODE=checkout/preapproval
